# VAYORA FASHION — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.

# ---- Frontend (exposed to the browser; safe ONLY because RLS protects data) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_SITE_URL=http://localhost:5173

# ---- Server-side ONLY (Edge Function secrets) ----
