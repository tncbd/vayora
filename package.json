{
  "name": "vayora-fashion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "db:bundle": "bash scripts/bundle-migrations.sh",
    "fn:bundle": "for f in place-order notify-order-status; do esbuild supabase/functions/$f/index.ts --bundle --format=esm --platform=neutral --external:npm:* --banner:js=\"// GENERATED by npm run fn:bundle. Paste this one file into the Supabase function editor.\" --outfile=supabase/functions/$f/deploy-single-file.ts; done"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
